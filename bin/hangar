#!/usr/bin/env bash
# Launcher installed to $PREFIX/bin. The package lives in $PREFIX/share/hangar.
set -euo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
PREFIX="$(dirname "$(dirname "$SELF")")"
APPDIR="$PREFIX/share/hangar"
export PYTHONPATH="$APPDIR${PYTHONPATH:+:$PYTHONPATH}"
# -P: never put the current directory on sys.path (it could shadow the package).
exec /usr/bin/python3 -P -m uam "$@"
